<resources>
    <color name="green">#1E7145</color>
    <color name="mint">#34D399</color>
    <color name="cyan">#22D3EE</color>
    <color name="danger">#F87171</color>
    <color name="on_accent">#04241B</color>
    <color name="bg_dark">#000000</color>
    <color name="bg_light">#E9EEF7</color>

    <!-- Dark glass on true black (default) -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/mint</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B4BDCC</item>
        <item name="android:textColorHint">#66FFFFFF</item>
        <item name="android:windowAnimationStyle">@style/WindowAnim</item>
        <item name="android:alertDialogTheme">@style/GlassDialog</item>
        <item name="android:datePickerDialogTheme">@style/GlassDialog</item>
        <item name="android:timePickerDialogTheme">@style/GlassDialog</item>
        <item name="android:windowSplashScreenBackground">@color/bg_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">700</item>
    </style>

    <!-- Light glass (optional, switched in Settings) -->
    <style name="AppTheme.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#0E9F6E</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:navigationBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">#0B1220</item>
        <item name="android:textColorSecondary">#4B566B</item>
        <item name="android:textColorHint">#660B1220</item>
        <item name="android:windowAnimationStyle">@style/WindowAnim</item>
        <item name="android:alertDialogTheme">@style/GlassDialog.Light</item>
        <item name="android:datePickerDialogTheme">@style/GlassDialog.Light</item>
        <item name="android:timePickerDialogTheme">@style/GlassDialog.Light</item>
    </style>

    <!-- Dialogs: near-opaque panel (many phones, including the OnePlus 8T, do not blur behind
         windows, and a see-through panel is unreadable without it). Blur is still requested. -->
    <style name="GlassDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/mint</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowBlurBehindEnabled">true</item>
        <item name="android:windowBlurBehindRadius">28dp</item>
        <item name="android:windowBackgroundBlurRadius">28dp</item>
        <item name="android:datePickerStyle">@style/GlassDatePicker</item>
        <item name="android:timePickerStyle">@style/GlassTimePicker</item>
    </style>

    <style name="GlassDialog.Light" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#0E9F6E</item>
        <item name="android:windowBackground">@drawable/dialog_bg_light</item>
        <item name="android:backgroundDimAmount">0.25</item>
        <item name="android:windowBlurBehindEnabled">true</item>
        <item name="android:windowBlurBehindRadius">28dp</item>
        <item name="android:windowBackgroundBlurRadius">28dp</item>
        <item name="android:datePickerStyle">@style/GlassDatePicker</item>
        <item name="android:timePickerStyle">@style/GlassTimePicker</item>
    </style>

    <!-- #61: pickers with a clear header so the glass panel shows through. -->
    <style name="GlassDatePicker" parent="android:Widget.Material.DatePicker">
        <item name="android:headerBackground">@android:color/transparent</item>
    </style>

    <style name="GlassTimePicker" parent="android:Widget.Material.TimePicker">
        <item name="android:headerBackground">@android:color/transparent</item>
        <item name="android:numbersBackgroundColor">#1AFFFFFF</item>
    </style>

    <style name="WindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/close_exit</item>
    </style>

    <!-- The android:tag values below are turned into glass backgrounds by Glass.apply(). -->
    <style name="Card">
        <item name="android:tag">card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <style name="Label">
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">?android:textColorSecondary</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="Field">
        <item name="android:tag">field</item>
        <item name="android:background">@null</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?android:textColorPrimary</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:textColorPrimary</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?android:textColorSecondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Toggle">
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="android:track">@drawable/switch_track</item>
        <item name="android:switchMinWidth">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?android:textColorPrimary</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="Primary">
        <item name="android:tag">primary</item>
        <item name="android:background">@null</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Pill">
        <item name="android:tag">pill</item>
        <item name="android:background">@null</item>
        <item name="android:textColor">?android:textColorPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:minWidth">0dp</item>
        <!-- Pill single line: stays tidy at large font sizes (#74) -->
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- Full-width secondary button -->
    <style name="Glass" parent="Pill">
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>
</resources>
