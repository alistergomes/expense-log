<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="6dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <!-- Revealed while the card is swiped: right to add, left to ignore. -->
    <TextView
        android:id="@+id/hintAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="18dp"
        android:alpha="0"
        android:text="✓  Add"
        android:textColor="@color/mint"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/hintIgnore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="18dp"
        android:alpha="0"
        android:text="Ignore  ✕"
        android:textColor="@color/danger"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.expenselog.app.GlassCard
        android:id="@+id/cardBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="14dp"
        android:paddingBottom="16dp"
        android:tag="card">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/flag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:textColor="#FBBF24"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:textColorPrimary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/method"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?android:colorAccent"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/detail"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="4"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/yes"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:contentDescription="Add to Excel"
            android:focusable="false"
            android:stateListAnimator="@null"
            android:tag="yes"
            android:text="✓"
            android:textColor="@color/on_accent"
            android:textSize="22dp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/no"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:contentDescription="Ignore and remove"
            android:focusable="false"
            android:stateListAnimator="@null"
            android:tag="no"
            android:text="✕"
            android:textColor="@color/danger"
            android:textSize="20dp" />
    </com.expenselog.app.GlassCard>
</FrameLayout>
