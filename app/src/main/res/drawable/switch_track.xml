<?xml version="1.0" encoding="utf-8"?>
<!-- #60: glass switch track: clear glass when off, lit mint-to-cyan when on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="52dp" android:height="30dp" />
            <corners android:radius="15dp" />
            <gradient android:angle="0" android:startColor="#E634D399" android:endColor="#E622D3EE" />
            <stroke android:width="1dp" android:color="#80FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="52dp" android:height="30dp" />
            <corners android:radius="15dp" />
            <solid android:color="#26FFFFFF" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
</selector>
